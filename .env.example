# Copiá este archivo a .env y completá tus valores. NUNCA subas .env al repo.

# Credenciales de tu cuenta del portal RNP Digital (consulta de vehículos)
RNP_EMAIL=tu-correo@ejemplo.com
RNP_PASSWORD=tu-password

# Ejecutar Chrome sin ventana (true en servidor, false para ver el navegador)
HEADLESS=true

# Opcional: si la definís, la API exige el header x-api-key en todo menos /health
API_KEY=

# Opcional: puerto de la API (default 3000)
PORT=3000

# Opcional: minutos de inactividad antes de cerrar Chrome (default 15; 0 = nunca)
IDLE_CLOSE_MIN=15
